# ============================================================================
# FaceTrack AI — Frontend environment variables
# ============================================================================
# HOW TO USE:
#   1. Make a copy of this file in the same folder and name it ".env"
#   2. Replace every value on the right of "=" with your real Firebase values
#   3. Restart the dev server:  npm run dev
#
# WHERE TO GET THESE VALUES (takes ~2 minutes):
#   a. Go to  https://console.firebase.google.com  and create a project
#      (or open an existing one).
#   b. Click the gear icon -> "Project settings".
#   c. Scroll to "Your apps". If there's no Web app yet, click the </> (Web)
#      icon to register one. Give it a nickname like "facetrack-web".
#   d. Firebase shows a "firebaseConfig" object. Copy each field below.
#   e. Enable the features you need:
#        - Authentication -> Sign-in method -> turn ON "Email/Password"
#        - Firestore Database -> Create database (test mode is fine to start)
#
# NOTE: All variables MUST start with VITE_ — that's how Vite exposes them to
# the browser. These are public client keys (safe to ship); security is
# enforced by Firebase Auth + Firestore rules, not by hiding these.
# Until a valid .env exists, the app runs in DEMO MODE (use the test-login
# buttons on the Login page).
# ----------------------------------------------------------------------------

# firebaseConfig.apiKey        -> looks like: AIzaSyD-xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_API_KEY=paste_your_apiKey_here

# firebaseConfig.authDomain    -> looks like: your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# firebaseConfig.projectId     -> looks like: your-project-id
VITE_FIREBASE_PROJECT_ID=your-project-id

# firebaseConfig.storageBucket -> looks like: your-project-id.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# firebaseConfig.messagingSenderId -> a long number, e.g. 123456789012
VITE_FIREBASE_MESSAGING_SENDER_ID=paste_your_messagingSenderId_here

# firebaseConfig.appId         -> looks like: 1:123456789012:web:abc123def456
VITE_FIREBASE_APP_ID=paste_your_appId_here

