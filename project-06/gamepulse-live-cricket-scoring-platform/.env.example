# GamePulse Live System Environment Configuration Template

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL / MySQL for Production)
DB_URL=jdbc:postgresql://localhost:5432/gamepulse
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=gamepulse_user
DB_PASSWORD=your_secure_db_password_here

# Security Configuration
JWT_SECRET=your_256bit_strong_jwt_secret_key_change_in_production_2026
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://gamepulselive.com,https://staging.gamepulselive.com

# Frontend Environment (Vite)
VITE_API_BASE_URL=https://api.gamepulselive.com/api
VITE_WS_BASE_URL=wss://api.gamepulselive.com/ws-gamepulse
